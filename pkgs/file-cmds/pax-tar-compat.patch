 /*
+ * strip_name()
+ *	drop the first strip_components path components of name (tar
+ *	--strip-components). Return 1 if nothing is left, so the member is
+ *	skipped, as bsdtar does.
+ */
+
+static int
+strip_name(char *name, int *nlen)
+{
+	char *p = name;
+	int i;
+
+	for (i = 0; i < strip_components; i++) {
+		while (*p == '/')
+			p++;
+		if (*p == '\0')
+			return (1);
+		while (*p != '\0' && *p != '/')
+			p++;
+	}
+	while (*p == '/')
+		p++;
+	if (*p == '\0')
+		return (1);
+	(void)memmove(name, p, strlen(p) + 1);
+	*nlen = (int)strlen(name);
+	return (0);
+}
